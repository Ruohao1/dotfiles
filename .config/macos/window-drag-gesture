#!/bin/sh

set -eu

LC_ALL=C
export LC_ALL
umask 077

program=${0##*/}
preference_key=NSWindowShouldDragOnGesture
target_value=true
preference_tmp=
tmp_base=
journal_status_tmp=
initializing_journal=
testing=false
test_read_count=0
preference_write_attempted=false
if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
  testing=true
fi

usage() {
  printf 'usage: %s (apply|can-restore|restore) JOURNAL_DIRECTORY\n' "$program"
}

error() {
  printf '%s: %s\n' "$program" "$1" >&2
}

validate_absolute_path() {
  checked_path=$1
  path_label=$2
  case "$checked_path" in
    /|''|*[[:cntrl:]]*)
      error "$path_label is unsafe"
      return 1
      ;;
    /*) ;;
    *)
      error "$path_label must be absolute"
      return 1
      ;;
  esac
}

cleanup() {
  if [ -n "$journal_status_tmp" ]; then
    case $journal_status_tmp in
      */.status.*) rm -f "$journal_status_tmp" ;;
    esac
  fi
  if [ -n "$initializing_journal" ] && [ -d "$initializing_journal" ]; then
    rmdir "$initializing_journal" 2>/dev/null || :
  fi
  if [ -n "$preference_tmp" ] && [ -d "$preference_tmp" ]; then
    case "$preference_tmp" in
      "$tmp_base"/dotfiles-window-drag.*) rm -rf "$preference_tmp" ;;
    esac
  fi
}

trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

prepare_temporary_directory() {
  [ -z "$preference_tmp" ] || return 0
  tmp_base=${TMPDIR:-/tmp}
  validate_absolute_path "$tmp_base" TMPDIR || return 1
  preference_tmp=$(mktemp -d "$tmp_base/dotfiles-window-drag.XXXXXX") || {
    error 'could not create temporary preference storage'
    return 1
  }
}

test_state_directory() {
  test_state=${DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_STATE:-}
  validate_absolute_path "$test_state" 'test preference state' || return 1
  if [ ! -d "$test_state" ] || [ -L "$test_state" ]; then
    error 'test preference state must be a real directory'
    return 1
  fi
}

normalize_boolean() {
  case $1 in
    1|true) printf '%s\n' true ;;
    0|false) printf '%s\n' false ;;
    *) return 1 ;;
  esac
}

read_current_value() {
  value_output=$1
  if [ "$testing" = true ]; then
    test_state_directory || return 1
    fail_read_at=${DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_FAIL_READ_AT:-0}
    case $fail_read_at in
      ''|*[!0-9]*)
        error 'test read failure index must be numeric'
        return 1
        ;;
    esac
    test_read_count=$((test_read_count + 1))
    if [ "$fail_read_at" -ne 0 ] \
      && [ "$test_read_count" -eq "$fail_read_at" ]; then
      error 'simulated window-drag preference read failure'
      return 1
    fi
    if [ "${DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_INVALID_TYPE:-0}" = 1 ]; then
      error 'window-drag preference is not Boolean'
      return 1
    fi
    if [ -f "$test_state/value" ] && [ ! -L "$test_state/value" ]; then
      raw_value=$(cat "$test_state/value") || return 1
    elif [ -e "$test_state/value" ] || [ -L "$test_state/value" ]; then
      error 'window-drag preference has an unsupported test schema'
      return 1
    else
      return 3
    fi
  else
    defaults_command=/usr/bin/defaults
    plutil_command=/usr/bin/plutil
    if [ ! -x "$defaults_command" ] || [ ! -x "$plutil_command" ]; then
      error 'macOS defaults and plutil are required'
      return 1
    fi
    prepare_temporary_directory || return 1
    domain_file=$preference_tmp/global-domain.plist
    normalized_domain_file=$preference_tmp/global-domain.xml
    if ! "$defaults_command" export NSGlobalDomain "$domain_file" \
        >/dev/null 2>&1; then
      error 'could not export the macOS global preference domain'
      return 1
    fi
    if ! "$plutil_command" -convert xml1 -o "$normalized_domain_file" \
        "$domain_file" >/dev/null 2>&1; then
      error 'the macOS global preference domain is not a valid property list'
      return 1
    fi
    if grep -Fq "<key>$preference_key</key>" "$normalized_domain_file"; then
      key_scan_status=0
    else
      key_scan_status=$?
    fi
    case $key_scan_status in
      0) ;;
      1) return 3 ;;
      *)
        error 'could not inspect the macOS global preference domain'
        return 1
        ;;
    esac
    value_type=$(
      "$plutil_command" -type "$preference_key" \
        "$normalized_domain_file" 2>/dev/null
    ) || {
      error 'window-drag preference type could not be read'
      return 1
    }
    if [ "$value_type" != bool ]; then
      error 'window-drag preference is not Boolean'
      return 1
    fi
    raw_value=$(
      "$plutil_command" -extract "$preference_key" raw \
        -o - "$normalized_domain_file" 2>/dev/null
    ) || {
      error 'window-drag preference could not be read from the global domain'
      return 1
    }
  fi

  normalized_value=$(normalize_boolean "$raw_value") || {
    error 'window-drag preference is not Boolean'
    return 1
  }
  printf '%s\n' "$normalized_value" >"$value_output" || {
    error 'could not record the window-drag preference value'
    return 1
  }
}

current_matches_state() {
  expected_present=$1
  expected_file=$2
  prepare_temporary_directory || return 1
  current_file=$preference_tmp/current.value
  if read_current_value "$current_file"; then
    current_status=0
  else
    current_status=$?
  fi
  case "$current_status:$expected_present" in
    0:true)
      if cmp -s "$current_file" "$expected_file"; then
        compare_status=0
      else
        compare_status=$?
      fi
      case $compare_status in
        0) return 0 ;;
        1) return 3 ;;
        *) return 1 ;;
      esac
      ;;
    0:false|3:true) return 3 ;;
    3:false) return 0 ;;
    *) return 1 ;;
  esac
}

simulate_prewrite_change() {
  [ "$testing" = true ] || return 0
  [ "${DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_CHANGE_BEFORE_WRITE+set}" = set ] \
    || return 0
  test_state_directory || return 1
  case $DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_CHANGE_BEFORE_WRITE in
    true|false)
      if ! printf '%s\n' \
          "$DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_CHANGE_BEFORE_WRITE" \
          >"$test_state/value"; then
        error 'could not simulate the pre-write preference change'
        return 1
      fi
      ;;
    absent)
      if ! rm -f "$test_state/value"; then
        error 'could not simulate an absent pre-write preference'
        return 1
      fi
      ;;
    *)
      error 'test pre-write value must be true, false, or absent'
      return 1
      ;;
  esac
  unset DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_CHANGE_BEFORE_WRITE
}

simulate_postwrite_change() {
  [ "$testing" = true ] || return 0
  [ "${DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_CHANGE_AFTER_WRITE+set}" = set ] \
    || return 0
  test_state_directory || return 1
  case $DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_CHANGE_AFTER_WRITE in
    true|false)
      if ! printf '%s\n' \
          "$DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_CHANGE_AFTER_WRITE" \
          >"$test_state/value"; then
        error 'could not simulate the post-write preference change'
        return 1
      fi
      ;;
    absent)
      if ! rm -f "$test_state/value"; then
        error 'could not simulate an absent post-write preference'
        return 1
      fi
      ;;
    *)
      error 'test post-write value must be true, false, or absent'
      return 1
      ;;
  esac
  unset DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_CHANGE_AFTER_WRITE
}

write_target_value() {
  if [ "$testing" = true ]; then
    test_state_directory || return 1
    preference_write_attempted=true
    printf '%s\n' "$target_value" >"$test_state/value" || return 1
    if [ "${DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_WRITE_THEN_FAIL:-0}" = 1 ]; then
      error 'simulated uncertain window-drag preference write failure'
      return 1
    fi
    return 0
  fi
  preference_write_attempted=true
  if ! /usr/bin/defaults write -g "$preference_key" -bool true >/dev/null; then
    error 'could not write the window-drag preference'
    return 1
  fi
}

write_saved_value() {
  saved_file=$1
  saved_value=$(cat "$saved_file") || return 1
  normalized_saved_value=$(normalize_boolean "$saved_value") || return 1
  if [ "$testing" = true ]; then
    test_state_directory || return 1
    printf '%s\n' "$normalized_saved_value" >"$test_state/value"
    return
  fi
  /usr/bin/defaults write -g "$preference_key" \
    -bool "$normalized_saved_value" >/dev/null
}

delete_current_value() {
  if [ "$testing" = true ]; then
    test_state_directory || return 1
    rm -f "$test_state/value"
    return
  fi
  /usr/bin/defaults delete -g "$preference_key" >/dev/null 2>&1
}

restore_previous_value() {
  journal_directory=$1
  if current_matches_state true "$journal_directory/after.value"; then
    compare_status=0
  else
    compare_status=$?
  fi
  case $compare_status in
    0) ;;
    3)
      error 'window-drag preference changed before it could be restored'
      return 3
      ;;
    *) return 1 ;;
  esac
  if [ -f "$journal_directory/before.present" ]; then
    write_saved_value "$journal_directory/before.value" || return 1
    expected_present=true
  else
    delete_current_value || return 1
    expected_present=false
  fi
  if [ "$testing" = true ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_STOP_AFTER_RESTORE_WRITE:-0}" = 1 ]; then
    return 75
  fi
  if current_matches_state "$expected_present" \
      "$journal_directory/before.value"; then
    verify_status=0
  else
    verify_status=$?
  fi
  case $verify_status in
    0) return 0 ;;
    3)
      error 'window-drag preference changed during restore verification'
      return 3
      ;;
    *)
      error 'window-drag preference restore verification failed'
      return 1
      ;;
  esac
}

current_matches_journal_before() {
  journal_directory=$1
  if [ -f "$journal_directory/before.present" ]; then
    current_matches_state true "$journal_directory/before.value"
    return
  fi
  current_matches_state false "$journal_directory/before.value"
}

set_journal_status() {
  journal_directory=$1
  next_status=$2
  journal_status_tmp=$(mktemp "$journal_directory/.status.XXXXXX") || {
    error "could not prepare window-drag journal status: $next_status"
    return 1
  }
  if ! printf '%s\n' "$next_status" >"$journal_status_tmp"; then
    rm -f "$journal_status_tmp"
    journal_status_tmp=
    error "could not record window-drag journal status: $next_status"
    return 1
  fi
  if ! mv "$journal_status_tmp" "$journal_directory/status"; then
    rm -f "$journal_status_tmp"
    journal_status_tmp=
    error "could not publish window-drag journal status: $next_status"
    return 1
  fi
  journal_status_tmp=
}

read_journal_status() {
  journal_directory=$1
  if [ ! -f "$journal_directory/status" ] \
    || [ -L "$journal_directory/status" ]; then
    error 'window-drag journal has no safe status file'
    return 1
  fi
  cat "$journal_directory/status"
}

validate_journal_values() {
  journal_directory=$1
  after_file=$journal_directory/after.value
  if [ ! -f "$after_file" ] || [ -L "$after_file" ]; then
    error 'window-drag journal is missing the applied value'
    return 1
  fi
  after_value=$(cat "$after_file") || return 1
  normalized_after=$(normalize_boolean "$after_value") || {
    error 'window-drag journal has an invalid applied value'
    return 1
  }
  if [ "$normalized_after" != "$target_value" ]; then
    error 'window-drag journal has an unexpected applied value'
    return 1
  fi

  before_marker=$journal_directory/before.present
  before_file=$journal_directory/before.value
  if [ -e "$before_marker" ] || [ -L "$before_marker" ]; then
    if [ ! -f "$before_marker" ] || [ -L "$before_marker" ] \
      || [ ! -f "$before_file" ] || [ -L "$before_file" ]; then
      error 'window-drag journal has an invalid previous-value record'
      return 1
    fi
    before_value=$(cat "$before_file") || return 1
    normalize_boolean "$before_value" >/dev/null || {
      error 'window-drag journal has an invalid previous value'
      return 1
    }
  elif [ -e "$before_file" ] || [ -L "$before_file" ]; then
    error 'window-drag journal has an unexpected previous value'
    return 1
  fi
}

apply_preference() {
  journal_directory=$1
  if [ -e "$journal_directory" ] || [ -L "$journal_directory" ]; then
    error "journal already exists: $journal_directory"
    return 1
  fi
  initializing_journal=$journal_directory
  if ! mkdir "$journal_directory"; then
    initializing_journal=
    error "could not create journal: $journal_directory"
    return 1
  fi
  if [ "$testing" = true ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_TERM_AFTER_JOURNAL_CREATE:-0}" = 1 ]; then
    kill -TERM "$$"
    return 143
  fi
  if ! set_journal_status "$journal_directory" failed; then
    rmdir "$journal_directory" 2>/dev/null || :
    return 1
  fi
  initializing_journal=
  if ! prepare_temporary_directory; then
    return 1
  fi

  before_file=$journal_directory/before.value
  if read_current_value "$before_file"; then
    before_status=0
  else
    before_status=$?
  fi
  case $before_status in
    0)
      if ! : >"$journal_directory/before.present"; then
        set_journal_status "$journal_directory" failed || :
        return 1
      fi
      before_present=true
      ;;
    3)
      if ! rm -f "$before_file"; then
        set_journal_status "$journal_directory" failed || :
        return 1
      fi
      before_present=false
      ;;
    *)
      set_journal_status "$journal_directory" failed || :
      return 1
      ;;
  esac

  after_file=$journal_directory/after.value
  if ! printf '%s\n' "$target_value" >"$after_file"; then
    set_journal_status "$journal_directory" failed || :
    return 1
  fi

  if ! simulate_prewrite_change; then
    set_journal_status "$journal_directory" failed || :
    return 1
  fi
  if current_matches_state "$before_present" "$before_file"; then
    compare_status=0
  else
    compare_status=$?
  fi
  case $compare_status in
    0) ;;
    3)
      error 'window-drag preference changed before it could be updated'
      set_journal_status "$journal_directory" failed || :
      return 3
      ;;
    *)
      set_journal_status "$journal_directory" failed || :
      return 1
      ;;
  esac

  if [ "$before_present" = true ]; then
    if cmp -s "$before_file" "$after_file"; then
      target_match_status=0
    else
      target_match_status=$?
    fi
    case $target_match_status in
      0)
        set_journal_status "$journal_directory" applied || return 1
        printf '%s\n' 'Window drag gesture was already enabled.'
        return 0
        ;;
      1) ;;
      *)
        set_journal_status "$journal_directory" failed || :
        return 1
        ;;
    esac
  fi

  if [ "$testing" = true ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_FAIL_WRITE:-0}" = 1 ]; then
    error 'simulated window-drag preference write failure'
    set_journal_status "$journal_directory" failed || :
    return 1
  fi

  set_journal_status "$journal_directory" preparing || return 1
  preference_write_attempted=false
  if write_target_value; then
    write_status=0
  else
    write_status=$?
  fi
  if [ "$write_status" -ne 0 ]; then
    if [ "$preference_write_attempted" = false ]; then
      set_journal_status "$journal_directory" failed || :
    fi
    return 1
  fi

  if [ "$testing" = true ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_WINDOW_DRAG_STOP_AFTER_WRITE:-0}" = 1 ]; then
    return 75
  fi

  if ! simulate_postwrite_change; then
    return 1
  fi

  if current_matches_state true "$after_file"; then
    verify_status=0
  else
    verify_status=$?
  fi
  case $verify_status in
    0) ;;
    3)
      error 'window-drag preference changed during apply verification'
      return 3
      ;;
    *)
      error 'window-drag preference verification failed'
      return 1
      ;;
  esac

  set_journal_status "$journal_directory" applied || return 1
  printf '%s\n' 'Window drag gesture enabled for Control+Command drag.'
}

can_restore_preference() {
  journal_directory=$1
  journal_status=$(read_journal_status "$journal_directory") || return 1
  case $journal_status in
    failed|restored) return 0 ;;
    applied|preparing) ;;
    *)
      error "window-drag journal has invalid status: ${journal_status:-missing}"
      return 1
      ;;
  esac
  validate_journal_values "$journal_directory" || return 1

  if current_matches_state true "$journal_directory/after.value"; then
    after_status=0
  else
    after_status=$?
  fi
  case $after_status in
    0) return 0 ;;
    1) return 1 ;;
    3)
      if [ "$journal_status" = applied ]; then
        error 'window-drag preference changed after bootstrap; refusing to overwrite it'
        return 3
      fi
      ;;
  esac

  if current_matches_journal_before "$journal_directory"; then
    before_status=0
  else
    before_status=$?
  fi
  case $before_status in
    0) return 0 ;;
    1) return 1 ;;
    3) ;;
  esac
  error 'window-drag preference changed after bootstrap; refusing to overwrite it'
  return 3
}

restore_preference() {
  journal_directory=$1
  journal_status=$(read_journal_status "$journal_directory") || return 1
  case $journal_status in
    failed|restored) return 0 ;;
  esac
  can_restore_preference "$journal_directory" || return $?

  if current_matches_journal_before "$journal_directory"; then
    before_status=0
  else
    before_status=$?
  fi
  case $before_status in
    0)
      set_journal_status "$journal_directory" restored || return 1
      return 0
      ;;
    1) return 1 ;;
    3) ;;
  esac

  set_journal_status "$journal_directory" preparing || return 1
  if restore_previous_value "$journal_directory"; then
    restore_status=0
  else
    restore_status=$?
  fi
  [ "$restore_status" -eq 0 ] || return "$restore_status"
  set_journal_status "$journal_directory" restored || return 1
  printf '%s\n' 'Window drag gesture restored.'
}

if [ "$#" -ne 2 ]; then
  usage >&2
  exit 2
fi

operation=$1
journal=$2
validate_absolute_path "$journal" journal || exit 2

case $operation in
  apply) apply_preference "$journal" ;;
  can-restore)
    [ -d "$journal" ] && [ ! -L "$journal" ] || {
      error "journal is unavailable: $journal"
      exit 1
    }
    can_restore_preference "$journal"
    ;;
  restore)
    [ -d "$journal" ] && [ ! -L "$journal" ] || {
      error "journal is unavailable: $journal"
      exit 1
    }
    restore_preference "$journal"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
