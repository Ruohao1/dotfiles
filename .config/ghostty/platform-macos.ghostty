# Option remains available to the macOS workspace layer and Unicode input.
macos-option-as-alt = false

# Remove the Linux adapter that was loaded from the XDG configuration.
keybind = alt+space=unbind
keybind = alt+n=unbind
keybind = alt+physical:one=unbind
keybind = alt+1=unbind
keybind = alt+physical:two=unbind
keybind = alt+2=unbind
keybind = alt+physical:three=unbind
keybind = alt+3=unbind
keybind = alt+physical:four=unbind
keybind = alt+4=unbind
keybind = alt+physical:five=unbind
keybind = alt+5=unbind
keybind = alt+physical:six=unbind
keybind = alt+6=unbind
keybind = alt+physical:seven=unbind
keybind = alt+7=unbind
keybind = alt+physical:eight=unbind
keybind = alt+8=unbind
keybind = alt+physical:nine=unbind
keybind = alt+9=unbind
keybind = alt+r=unbind
keybind = alt+q=unbind
keybind = alt+shift+q=unbind
keybind = alt+backslash=unbind
keybind = alt+shift+backslash=unbind
keybind = alt+f=unbind
keybind = alt+h=unbind
keybind = alt+j=unbind
keybind = alt+k=unbind
keybind = alt+l=unbind
keybind = alt+shift+h=unbind
keybind = alt+shift+j=unbind
keybind = alt+shift+k=unbind
keybind = alt+shift+l=unbind

# Disable remaining native macOS tab and split actions.
keybind = super+t=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+alt+w=unbind
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+[=unbind
keybind = super+]=unbind
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_down=unbind
keybind = super+alt+arrow_up=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+ctrl+arrow_left=unbind
keybind = super+ctrl+arrow_down=unbind
keybind = super+ctrl+arrow_up=unbind
keybind = super+ctrl+arrow_right=unbind
keybind = super+ctrl+==unbind
keybind = super+shift+enter=unbind

# Selected Command chords emit the same canonical Meta protocol as Linux Alt.
keybind = super+space=text:\x1b\x20
keybind = super+n=esc:n
keybind = super+physical:one=esc:1
keybind = super+1=esc:1
keybind = super+physical:two=esc:2
keybind = super+2=esc:2
keybind = super+physical:three=esc:3
keybind = super+3=esc:3
keybind = super+physical:four=esc:4
keybind = super+4=esc:4
keybind = super+physical:five=esc:5
keybind = super+5=esc:5
keybind = super+physical:six=esc:6
keybind = super+6=esc:6
keybind = super+physical:seven=esc:7
keybind = super+7=esc:7
keybind = super+physical:eight=esc:8
keybind = super+8=esc:8
keybind = super+physical:nine=esc:9
keybind = super+9=esc:9
keybind = super+r=esc:r
keybind = super+q=esc:q
keybind = super+shift+q=esc:Q
keybind = super+backslash=text:\x1b\x5c
keybind = super+shift+backslash=esc:|
keybind = super+f=esc:f
keybind = super+h=esc:h
keybind = super+j=esc:j
keybind = super+k=esc:k
keybind = super+l=esc:l
keybind = super+shift+h=esc:H
keybind = super+shift+j=esc:J
keybind = super+shift+k=esc:K
keybind = super+shift+l=esc:L
