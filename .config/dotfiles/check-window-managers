#!/bin/sh

set -eu

LC_ALL=C
export LC_ALL

program=${0##*/}
script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH='' cd -- "$script_dir/../.." && pwd)

usage() {
  printf 'usage: %s [--root PATH]\n' "$program"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --root)
      [ "$#" -ge 2 ] || {
        usage >&2
        exit 2
      }
      root=$2
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

case "$root" in
  /*) ;;
  *)
    printf '%s: root must be an absolute path\n' "$program" >&2
    exit 2
    ;;
esac

manifest=$root/.config/dotfiles/manifests/window-manager-bindings.tsv
hypr_config=$root/.config/hypr/hyprland.lua
i3_config=$root/.config/i3/config
i3_dwindle=$root/.config/i3/dwindle
aerospace_config=$root/.config/aerospace/aerospace.toml
aerospace_dwindle=$root/.config/aerospace/dwindle
hypr_touchpad_natural_scroll='            natural_scroll = true,'
hypr_workspace_animation='hl.animation({ leaf = "workspaces", enabled = false })'
hypr_workspace_gesture='hl.gesture({ fingers = 3, direction = "horizontal", action = "workspace" })'

failures=0
checks=0

pass() {
  checks=$((checks + 1))
  printf 'PASS  %s\n' "$1"
}

fail() {
  checks=$((checks + 1))
  failures=$((failures + 1))
  printf 'FAIL  %s\n' "$1" >&2
}

repository_tracks_path() {
  tracked_relative=$1
  command -v git >/dev/null 2>&1 || return 1

  if [ -e "$root/.git" ]; then
    git -C "$root" ls-files --error-unmatch -- "$tracked_relative" \
      >/dev/null 2>&1
    return
  fi
  if [ -d "$root/.cfg" ]; then
    git --git-dir="$root/.cfg" --work-tree="$root" \
      ls-files --error-unmatch -- "$tracked_relative" \
      >/dev/null 2>&1
    return
  fi
  return 1
}

for required_file in \
  "$manifest" \
  "$hypr_config" \
  "$i3_config" \
  "$i3_dwindle" \
  "$aerospace_config" \
  "$aerospace_dwindle"
do
  if [ -r "$required_file" ]; then
    pass "readable file: ${required_file#"$root/"}"
  else
    fail "readable file: ${required_file#"$root/"}"
  fi
done

for required_helper in "$i3_dwindle" "$aerospace_dwindle"; do
  if [ -x "$required_helper" ]; then
    pass "executable helper: ${required_helper#"$root/"}"
  else
    fail "executable helper: ${required_helper#"$root/"}"
  fi

  if [ -r "$required_helper" ] && sh -n "$required_helper"; then
    pass "valid shell syntax: ${required_helper#"$root/"}"
  else
    fail "valid shell syntax: ${required_helper#"$root/"}"
  fi
done

if [ "$failures" -ne 0 ]; then
  printf 'Summary: %d failure(s), %d check(s)\n' "$failures" "$checks" >&2
  exit 1
fi

tmp_base=${TMPDIR:-/tmp}
check_tmp=$(mktemp -d "$tmp_base/window-manager-check.XXXXXX")
cleanup() {
  case "$check_tmp" in
    "$tmp_base"/window-manager-check.*) rm -rf "$check_tmp" ;;
  esac
}
trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

sed 's/^[[:space:]]*//' "$aerospace_config" >"$check_tmp/aerospace.normalized"
: >"$check_tmp/actions"
: >"$check_tmp/logical-keys"

tab=$(printf '\t')
rows=0
while IFS="$tab" read -r action logical_key hypr_key hypr_action \
  i3_key i3_action aerospace_key aerospace_action extra \
  || [ -n "${action:-}" ]
do
  case ${action:-} in
    ''|'#'*) continue ;;
  esac
  rows=$((rows + 1))

  case "$action" in
    *[!a-z0-9-]*)
      fail "contract action has unsafe characters: $action"
      continue
      ;;
  esac
  if [ -n "${extra:-}" ] \
    || [ -z "$logical_key" ] \
    || [ -z "$hypr_key" ] \
    || [ -z "$hypr_action" ] \
    || [ -z "$i3_key" ] \
    || [ -z "$i3_action" ] \
    || [ -z "$aerospace_key" ] \
    || [ -z "$aerospace_action" ]; then
    fail "contract row has exactly eight non-empty fields: $action"
    continue
  fi

  if grep -Fqx "$action" "$check_tmp/actions"; then
    fail "contract action is unique: $action"
  else
    printf '%s\n' "$action" >>"$check_tmp/actions"
  fi
  if grep -Fqx "$logical_key" "$check_tmp/logical-keys"; then
    fail "contract logical key is unique: $logical_key"
  else
    printf '%s\n' "$logical_key" >>"$check_tmp/logical-keys"
  fi

  hypr_expected="hl.bind(\"$hypr_key\", $hypr_action)"
  i3_expected="bindsym $i3_key $i3_action"
  aerospace_expected="$aerospace_key = '$aerospace_action'"

  hypr_count=$(grep -Fxc "$hypr_expected" "$hypr_config" || true)
  i3_count=$(grep -Fxc "$i3_expected" "$i3_config" || true)
  aerospace_count=$(grep -Fxc "$aerospace_expected" \
    "$check_tmp/aerospace.normalized" || true)

  if [ "$hypr_count" -eq 1 ]; then
    pass "Hyprland implements $action exactly once"
  else
    fail "Hyprland implements $action exactly once"
  fi
  if [ "$i3_count" -eq 1 ]; then
    pass "i3 implements $action exactly once"
  else
    fail "i3 implements $action exactly once"
  fi
  if [ "$aerospace_count" -eq 1 ]; then
    pass "AeroSpace implements $action exactly once"
  else
    fail "AeroSpace implements $action exactly once"
  fi
done <"$manifest"

if [ "$rows" -eq 40 ]; then
  pass 'contract contains exactly 40 shared bindings'
else
  fail "contract contains exactly 40 shared bindings (found $rows)"
fi

if ! grep -Fqx 'hl.bind("SUPER + SHIFT + C", hl.dsp.exec_cmd("hyprctl reload"))' \
    "$hypr_config" \
  && ! grep -Fqx "bindsym \$mod+Shift+c reload" "$i3_config" \
  && ! grep -Fqx "alt-shift-c = 'reload-config'" \
    "$check_tmp/aerospace.normalized"; then
  pass 'obsolete WM+Shift+C reload bindings are removed everywhere'
else
  fail 'obsolete WM+Shift+C reload bindings are removed everywhere'
fi

if grep -Fqx 'hl.bind("SUPER + 1", hl.dsp.focus({ workspace = "name:0" }))' \
  "$hypr_config" \
  && grep -Fqx "bindsym \$mod+1 workspace --no-auto-back-and-forth \"0\"" \
    "$i3_config" \
  && grep -Fqx "alt-1 = 'workspace 0'" "$check_tmp/aerospace.normalized"; then
  pass 'physical key 1 selects logical workspace 0 everywhere'
else
  fail 'physical key 1 selects logical workspace 0 everywhere'
fi

if grep -Fq 'follow_mouse = 0' "$hypr_config" \
  && grep -Fqx 'focus_follows_mouse no' "$i3_config" \
  && grep -Fqx 'focus-follows-mouse.enabled = false' "$aerospace_config"; then
  pass 'focus-follows-mouse is disabled everywhere'
else
  fail 'focus-follows-mouse is disabled everywhere'
fi

if [ "$(grep -Fxc '        force_split = 2,' "$hypr_config" || true)" -eq 1 ] \
  && [ "$(grep -Fxc '        preserve_split = true,' "$hypr_config" || true)" -eq 1 ]; then
  pass 'Hyprland uses deterministic right-or-bottom Dwindle placement'
else
  fail 'Hyprland uses deterministic right-or-bottom Dwindle placement'
fi

if [ "$(grep -Fxc "$hypr_touchpad_natural_scroll" "$hypr_config" || true)" -eq 1 ] \
  && [ "$(grep -Fxc '        natural_scroll = true,' "$hypr_config" || true)" -eq 0 ]; then
  pass 'Hyprland enables natural scrolling only for the touchpad'
else
  fail 'Hyprland enables natural scrolling only for the touchpad'
fi

if [ "$(grep -Fxc "$hypr_workspace_animation" "$hypr_config" || true)" -eq 1 ]; then
  pass 'Hyprland disables animated shortcut workspace transitions'
else
  fail 'Hyprland disables animated shortcut workspace transitions'
fi

if [ "$(grep -Fxc "$hypr_workspace_gesture" "$hypr_config" || true)" -eq 1 ]; then
  pass 'Hyprland enables one three-finger horizontal workspace gesture'
else
  fail 'Hyprland enables one three-finger horizontal workspace gesture'
fi

i3_dwindle_start='exec --no-startup-id ~/.config/i3/dwindle'
if [ "$(grep -Fxc "$i3_dwindle_start" "$i3_config" || true)" -eq 1 ]; then
  pass 'i3 starts exactly one Dwindle event helper'
else
  fail 'i3 starts exactly one Dwindle event helper'
fi

aerospace_dwindle_callback="on-window-detected = [{ check-further-callbacks = true, run = 'exec-and-forget /bin/sh \"\${HOME}/.config/aerospace/dwindle\"' }]"
if [ "$(grep -Fxc "$aerospace_dwindle_callback" \
    "$check_tmp/aerospace.normalized" || true)" -eq 1 ]; then
  pass 'AeroSpace runs exactly one Dwindle window callback'
else
  fail 'AeroSpace runs exactly one Dwindle window callback'
fi

if grep -Fqx \
    'hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true })' \
    "$hypr_config" \
  && grep -Fqx \
    'hl.bind("SUPER + mouse:273", hl.dsp.window.resize(), { mouse = true })' \
    "$hypr_config"; then
  pass 'Hyprland supports Super plus left-drag move and right-drag resize'
else
  fail 'Hyprland supports Super plus left-drag move and right-drag resize'
fi

if grep -Fqx "floating_modifier \$mod" "$i3_config" \
  && grep -Fqx 'tiling_drag modifier' "$i3_config"; then
  pass 'i3 supports Super plus mouse drag for floating and tiled windows'
else
  fail 'i3 supports Super plus mouse drag for floating and tiled windows'
fi

if grep -Fq 'dofile(local_config)' "$hypr_config" \
  && grep -Fqx 'include ~/.config/i3/local.conf' "$i3_config" \
  && grep -Fqx \
    "after-startup-command = ['exec-and-forget /bin/sh \${HOME}/.config/aerospace/local.sh']" \
    "$aerospace_config"; then
  pass 'each manager has only its portable local override boundary'
else
  fail 'each manager has only its portable local override boundary'
fi

if awk \
  -v allowed_animation="$hypr_workspace_animation" \
  -v allowed_gesture="$hypr_workspace_gesture" '
  /hl[.]dsp[.]exec_/ \
    && $0 !~ /hl[.]dsp[.]exec_cmd[(]"hyprctl reload"[)]/ \
    && $0 !~ /hl[.]dsp[.]exec_cmd[(]"[$]HOME[/][.]config[/]launcher[/]application-launcher"[)]/ {
    bad = 1
  }
  /hl[.](on|window_rule|layer_rule|curve|device)[(]/ {
    bad = 1
  }
  /hl[.]animation[(]/ {
    line = $0
    sub(/^[[:space:]]*/, "", line)
    if (line != allowed_animation) {
      bad = 1
    }
  }
  /hl[.]gesture[(]/ {
    line = $0
    sub(/^[[:space:]]*/, "", line)
    if (line != allowed_gesture) {
      bad = 1
    }
  }
  END { exit bad }
' "$hypr_config"; then
  pass 'Hyprland config contains only approved launcher and workspace interaction exceptions'
else
  fail 'Hyprland config contains only approved launcher and workspace interaction exceptions'
fi

if awk -v allowed_exec="$i3_dwindle_start" '
  /^[[:space:]]*(bar|assign|for_window|client[.])/ {
    bad = 1
  }
  /^[[:space:]]*(exec|exec_always)([[:space:]]|$)/ {
    line = $0
    sub(/^[[:space:]]*/, "", line)
    if (line != allowed_exec) {
      bad = 1
    }
  }
  END { exit bad }
' "$i3_config"; then
  pass 'i3 config contains only the allowlisted Dwindle helper process'
else
  fail 'i3 config contains only the allowlisted Dwindle helper process'
fi

if awk -v allowed_callback="$aerospace_dwindle_callback" '
  /^[[:space:]]*(exec-on-workspace-change|gaps[.]|workspace-to-monitor-force-assignment)/ {
    bad = 1
  }
  /^[[:space:]]*on-window-detected([[:space:]]|=)/ {
    line = $0
    sub(/^[[:space:]]*/, "", line)
    if (line != allowed_callback) {
      bad = 1
    }
  }
  END { exit bad }
' "$aerospace_config"; then
  pass 'AeroSpace config contains only the allowlisted Dwindle callback'
else
  fail 'AeroSpace config contains only the allowlisted Dwindle callback'
fi

if ! repository_tracks_path .config/hypr/hyprland.conf \
  && ! repository_tracks_path .aerospace.toml; then
  pass 'repository contains no legacy manager entrypoint'
else
  fail 'repository contains no legacy manager entrypoint'
fi

if command -v luac >/dev/null 2>&1; then
  if luac -p "$hypr_config"; then
    pass 'Hyprland config passes luac syntax validation'
  else
    fail 'Hyprland config passes luac syntax validation'
  fi
fi

if command -v i3 >/dev/null 2>&1; then
  if i3 -C -c "$i3_config" >/dev/null 2>&1; then
    pass 'i3 config passes native offline validation'
  else
    fail 'i3 config passes native offline validation'
  fi
fi

if [ "$(uname -s)" = Darwin ] \
  && command -v aerospace >/dev/null 2>&1 \
  && [ -S "/tmp/bobko.aerospace-$(id -un).sock" ]; then
  if aerospace reload-config --dry-run --no-gui --warnings-as-errors \
    >/dev/null 2>&1; then
    pass 'AeroSpace config passes native live validation'
  else
    fail 'AeroSpace config passes native live validation'
  fi
fi

printf 'Summary: %d failure(s), %d check(s)\n' "$failures" "$checks"
[ "$failures" -eq 0 ]
